<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hi.hbv401.ui.BookingController">
    <!-- Top Section - Header -->
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2a2a2a; -fx-padding: 20px;">
            <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Luxury Stays" />
        </HBox>
    </top>
    
    <!-- Center Section - Booking Details and Payment Form -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40px;">
            <Text style="-fx-font-size: 24px; -fx-fill: #2a2a2a;" text="Confirm Your Booking" />
            
            <!-- Booking Details Section -->
            <VBox style="-fx-background-color: #f8f9fa; -fx-padding: 20px; -fx-background-radius: 5;">
                <Text style="-fx-font-size: 18px; -fx-fill: #2a2a2a; -fx-font-weight: bold;" text="Booking Details" />
                <Separator style="-fx-padding: 5 0 10 0;"/>
                
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="250" />
                    </columnConstraints>
                    
                    <Label text="Hotel:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
                    <Label fx:id="hotelNameLabel" text="[Hotel Name]" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    
                    <Label text="Room Number:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                    <Label fx:id="roomNumberLabel" text="[Room Number]" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    
                    <Label text="Check-in Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;" />
                    <Label fx:id="checkinDateLabel" text="[Check-in Date]" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    
                    <Label text="Check-out Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;" />
                    <Label fx:id="checkoutDateLabel" text="[Check-out Date]" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    
                    <Label text="Total Nights:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;" />
                    <Label fx:id="totalNightsLabel" text="[Total Nights]" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    
                    <Label text="Total Price:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;" />
                    <Label fx:id="totalPriceLabel" text="[Total Price]" GridPane.columnIndex="1" GridPane.rowIndex="5" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                </GridPane>
            </VBox>
            
            <!-- Payment Details Section -->
            <VBox style="-fx-background-color: #f8f9fa; -fx-padding: 20px; -fx-background-radius: 5;">
                <Text style="-fx-font-size: 18px; -fx-fill: #2a2a2a; -fx-font-weight: bold;" text="Payment Information" />
                <Separator style="-fx-padding: 5 0 10 0;"/>
                
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="150" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="200" prefWidth="250" />
                    </columnConstraints>
                    
                    <Label text="Card Holder Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="cardHolderField" promptText="Full name on card" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    
                    <Label text="Card Number:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="cardNumberField" promptText="XXXX XXXX XXXX XXXX" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    
                    <Label text="Expiry Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <ComboBox fx:id="expiryMonthCombo" promptText="MM" prefWidth="70" />
                        <ComboBox fx:id="expiryYearCombo" promptText="YYYY" prefWidth="85" />
                    </HBox>
                    
                    <Label text="CVV:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="cvvField" promptText="XXX" maxWidth="70" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    
                    <Label text="Billing Address:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextArea fx:id="billingAddressArea" promptText="Enter your billing address" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </GridPane>
            </VBox>
            
            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="cancelButton" onAction="#handleCancel" style="-fx-font-size: 16px; -fx-background-color: #6c757d; -fx-text-fill: white;" text="Cancel" />
                <Button fx:id="confirmButton" onAction="#handleConfirm" style="-fx-font-size: 16px; -fx-background-color: #28a745; -fx-text-fill: white;" text="Confirm Booking" />
            </HBox>
        </VBox>
    </center>
    
    <!-- Bottom Section - Footer -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 15px;">
            <Label style="-fx-text-fill: #6c757d;" text="Contact us: info@luxurystays.com | Tel: (555) 123-4567" />
        </HBox>
    </bottom>
</BorderPane>