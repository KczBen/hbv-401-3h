<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="hi.hbv401.ui.HotelCardController"
      spacing="10" style="-fx-padding: 10; -fx-border-color: lightgray; -fx-border-width: 1; -fx-background-color: white; -fx-background-radius: 8;">
    
    <HBox spacing="10">
        <ImageView fx:id="indexPhoto" 
                   preserveRatio="true" 
                   fitWidth="100" 
                   fitHeight="100" />
        <VBox>
            <Label fx:id="hotelName" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label fx:id="rating" />
            <Label fx:id="startingPrice" />
            <Label fx:id="description" wrapText="true" />
            <Label fx:id="address" />
            <Label fx:id="cancelPolicy" />
        </VBox>
    </HBox>
    
    <TitledPane fx:id="roomPane" text="Rooms" expanded="false">
        <VBox fx:id="roomList" spacing="10" style="-fx-padding: 10;" />
    </TitledPane>
</VBox>