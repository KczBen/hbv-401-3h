<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="hi.hbv401.ui.BookingCardController"
      spacing="10" style="-fx-padding: 10; -fx-border-color: lightgray; -fx-border-width: 1; -fx-background-color: white; -fx-background-radius: 8;">
    
    <HBox spacing="10">
        <ImageView fx:id="indexPhoto" 
                   preserveRatio="true" 
                   fitWidth="100" 
                   fitHeight="100" />
        <Label fx:id="hotelName" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        <Label fx:id="roomNumber" />
        <Label fx:id="bookedFrom" />
        <Label fx:id="bookedUntil" />
        <Label fx:id="address" />
        <Label fx:id="cancelPolicy" />
        <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel booking" /> 
    </HBox>
</VBox>